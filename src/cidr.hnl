--- `ip.cidr.*` — pure-Handl CIDR ops. Value rep: { addr: Int, len: Int }.
from "./internal/num.hnl" import dec_int
from "./internal/num.hnl" import int_dec
from "./ipv4.hnl" import parse
from "./ipv4.hnl" import format

export cidr_parse := (s) ~> do {
  parts := str.split(s, "/")
  addr := 0
  plen := 0
  i := 0
  for p in parts { do {
    if i == 0 { do { addr := parse(p) } } else { do { plen := dec_int(p) } }
    i := i + 1
  } }
  if i == 2 && plen >= 0 && plen <= 32 { do { { addr: addr, len: plen } } } else {
    throw "ip.cidr.parse: invalid CIDR"
  }
}

export cidr_format := (v) ~> format(v.addr) + "/" + int_dec(v.len)

shift := (plen) ~> math.shl(1, 32 - plen)
net_of := (v) ~> v.addr - (v.addr % shift(v.len))

export contains := (v, addr) ~> do {
  math.shr(addr, 32 - v.len) == math.shr(v.addr, 32 - v.len)
}
export network := (v) ~> format(net_of(v))
export broadcast := (v) ~> format(net_of(v) + shift(v.len) - 1)
